{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // The unit tests run on Node's native type stripping, which does no module
    // resolution — relative imports must carry the .ts extension. Safe here
    // because this project only ever typechecks with --noEmit; Metro bundles
    // the app itself.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
